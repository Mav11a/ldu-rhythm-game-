                likes: 92,
                isSeed: true
            },
            {
                id: 'seed-1',
                author: 'Arcaea魔王喵',
                game: 'Arcaea',
                rating: 'PTT 12.92',
                title: '鲁大音游群同好',
                category: '个人高光成绩',
