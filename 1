        function showToast(title, msg, iconClass = 'fa-solid fa-bolt') {
            const toast = document.getElementById('toast');
            document.getElementById('toast-title').innerText = title;
            document.getElementById('toast-msg').innerText = msg;
            document.getElementById('toast-icon').className = `${iconClass} text-lg`;
            toast.classList.remove('translate-x-[150%]');
            setTimeout(() => {
                toast.classList.add('translate-x-[150%]');
            }, 3200);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/[&<>"']/g, s => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[s]));
        }

        window.onUserReady = async function(user) {
            const { db, appId, collection, query, onSnapshot } = window.fb;
            const highlightsRef = collection(db, 'artifacts', appId, 'public', 'data', 'rhythm_highlights');
            const q = query(highlightsRef);

            onSnapshot(q, (snapshot) => {
                const cloudItems = [];
                snapshot.forEach((docSnap) => {
                    cloudItems.push({
                        id: docSnap.id,
                        ...docSnap.data(),
                        isSeed: false
                    });
                });

                cloudItems.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
                allHighlights = [...cloudItems, ...starterHighlights];
                renderHighlightsGrid();
            }, (error) => {
                console.error("Highlights snapshot error:", error);
                allHighlights = [...starterHighlights];
                renderHighlightsGrid();
            });
        };

        function getBadgeStyle(badgeText) {
            if (badgeText.includes('MAX')) return 'badge-max';
            if (badgeText.includes('PERFECT') || badgeText.includes('AP')) return 'badge-ap';
            if (badgeText.includes('COMBO') || badgeText.includes('FC')) return 'badge-fc';
            return 'badge-quote';
        }

        function renderHighlightsGrid() {
            const grid = document.getElementById('highlights-grid');
            const filtered = currentFilter === 'ALL'
                ? allHighlights
                : allHighlights.filter(item => item.category === currentFilter);

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full bg-cyber-card border border-slate-800 rounded-3xl p-12 text-center">
                        <i class="fa-solid fa-compact-disc text-4xl text-cyber-cyan mb-3 animate-spin"></i>
                        <h4 class="text-lg font-bold text-white">该分区暂时还没有动态哦</h4>
                        <p class="text-xs text-slate-400 mt-1 mb-5">快来抢占沙发，发布第一条高光战绩或金句吧！</p>
                        <button onclick="openPostModal()" class="bg-cyber-cyan text-black font-extrabold px-5 py-2.5 rounded-xl text-xs">立即发布</button>
                    </div>
                `;
                return;
            }

            grid.innerHTML = filtered.map((item) => {
                const initial = (item.author || '音').charAt(0).toUpperCase();
                const badgeClass = getBadgeStyle(item.badge || '神仙金句');
                const likesCount = Number(item.likes || 0);
                const isLiked = likedPostIds.has(item.id);
                const isOwner = window.currentUser && item.uid === window.currentUser.uid;

                return `
                <div class="bg-cyber-card hover:bg-[#1d2238] border ${item.isSeed ? 'border-slate-800' : 'border-cyber-cyan/40'} rounded-3xl p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 shadow-xl relative overflow-hidden group">
                    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-cyber-cyan via-cyber-purple to-cyber-pink opacity-75"></div>

                    <div>
                        <div class="flex items-center justify-between gap-2 mb-4">
                            <span class="px-2.5 py-1 rounded-lg bg-cyber-dark border border-slate-700/80 text-[11px] font-mono-num font-bold text-cyber-cyan flex items-center gap-1.5">
                                <i class="fa-solid fa-gamepad text-[10px]"></i>
                                <span>${escapeHtml(item.game || '全能音游')}</span>
                            </span>
                            <span class="px-2.5 py-0.5 rounded-md text-[10px] font-mono-num font-black tracking-wider uppercase shadow-sm ${badgeClass}">
                                ${escapeHtml(item.badge || '神仙金句')}
                            </span>
                        </div>

                        ${item.song ? `
                        <div class="mb-3 inline-flex items-center space-x-1.5 bg-cyber-dark/70 border border-slate-800 px-3 py-1 rounded-lg text-xs text-slate-300 font-mono-num max-w-full truncate">
                            <i class="fa-solid fa-location-dot text-cyber-pink text-[10px]"></i>
                            <span class="truncate">${escapeHtml(item.song)}</span>
                        </div>
                        ` : ''}

                        ${item.imageUrl ? `
                        <div onclick="openLightbox('${escapeHtml(item.imageUrl)}', '${escapeHtml(item.song || item.author)}', '${escapeHtml(item.content)}')" class="mb-4 rounded-2xl overflow-hidden border border-slate-800 h-44 relative cursor-pointer group/img">
                            <img src="${escapeHtml(item.imageUrl)}" onerror="this.parentElement.style.display='none'" alt="群友日常配图" class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-500">
                            <div class="absolute bottom-2 right-2 bg-black/70 backdrop-blur-md text-white text-[10px] px-2.5 py-1 rounded-lg flex items-center gap-1">
                                <i class="fa-solid fa-magnifying-glass-plus text-cyber-cyan"></i> 点击放大
                            </div>
                        </div>
                        ` : ''}

                        <div class="relative mb-6">
                            <p class="text-slate-200 text-sm leading-relaxed font-normal">
                                ${escapeHtml(item.content)}
                            </p>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-800/90 flex items-center justify-between gap-2">
                        <div class="flex items-center space-x-3 min-w-0">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyber-cyan/20 to-cyber-pink/20 border border-cyber-cyan/30 text-cyber-cyan flex items-center justify-center font-black text-sm shrink-0">
                                ${escapeHtml(initial)}
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-white text-sm font-extrabold truncate">${escapeHtml(item.author)}</span>
                                    ${item.rating ? `<span class="text-[10px] font-mono-num px-1.5 py-0.5 rounded bg-slate-800 text-cyber-yellow shrink-0">${escapeHtml(item.rating)}</span>` : ''}
                                </div>
                                <div class="text-[11px] text-slate-400 truncate">${escapeHtml(item.title || '群内活跃同好')}</div>
                            </div>
                        </div>

                        <div class="flex items-center gap-1.5 shrink-0">
                            ${isOwner && !item.isSeed ? `
                            <button onclick="deleteHighlight('${item.id}')" title="删除该动态" class="w-8 h-8 rounded-xl bg-slate-800/80 hover:bg-red-500/20 text-slate-400 hover:text-red-400 flex items-center justify-center text-xs transition-colors">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                            ` : ''}
                            <button onclick="likeHighlight('${item.id}', ${item.isSeed}, ${likesCount})" class="px-3 py-1.5 rounded-xl border ${isLiked ? 'bg-cyber-pink/20 border-cyber-pink text-cyber-pink' : 'bg-cyber-dark/80 border-slate-800 text-slate-300 hover:border-cyber-pink/50 hover:text-white'} flex items-center space-x-1.5 text-xs font-mono-num font-bold transition-all">
                                <i class="fa-solid fa-heart ${isLiked ? 'text-cyber-pink scale-110' : 'text-slate-400'} transition-transform"></i>
                                <span>${likesCount}</span>
                            </button>
                        </div>
                    </div>
                </div>
                `;
            }).join('');
        }

        function setHighlightFilter(category) {
            currentFilter = category;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if (btn.getAttribute('data-filter') === category) {
                    btn.className = 'filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-cyber-cyan text-black shadow-md';
                } else {
                    btn.className = 'filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-cyber-card text-slate-300 hover:text-white border border-slate-800';
                }
            });
            renderHighlightsGrid();
        }

        async function submitHighlightPost(event) {
            event.preventDefault();
            if (!window.currentUser) return;

            const author = document.getElementById('post-author').value.trim() || '鲁大神秘音游人';
            const game = document.getElementById('post-game').value;
            const rating = document.getElementById('post-rating').value.trim();
            const category = document.getElementById('post-category').value;
            const badge = document.getElementById('post-badge').value;
            const song = document.getElementById('post-song').value.trim();
            const imageUrl = document.getElementById('post-image').value.trim();
            const content = document.getElementById('post-content').value.trim();
            const btn = document.getElementById('post-submit-btn');

            if (!content) return;
            btn.disabled = true;
            btn.innerText = '正在上传至高光墙...';

            try {
                const { db, appId, collection, addDoc } = window.fb;
                const highlightsRef = collection(db, 'artifacts', appId, 'public', 'data', 'rhythm_highlights');

                await addDoc(highlightsRef, {
                    uid: window.currentUser.uid,
                    author,
                    game,
                    rating,
                    title: '鲁大音游群同好',
                    category,
                    badge,
                    song,
                    imageUrl,
                    content,
                    likes: 1,
                    createdAt: Date.now()
                });

                document.getElementById('post-song').value = '';
                document.getElementById('post-image').value = '';
                document.getElementById('post-content').value = '';
                closePostModal();
                showToast('上墙成功！', '你的日常与高光动态已实时展示给所有群友！', 'fa-solid fa-fire');
            } catch (err) {
                console.error("Error adding highlight:", err);
                showToast('发布失败', '请检查网络连接后重试', 'fa-solid fa-triangle-exclamation');
            } finally {
                btn.disabled = false;
                btn.innerText = '立即上墙展示';
            }
        }

        async function likeHighlight(id, isSeed, currentLikes) {
            if (!window.currentUser) return;
            if (likedPostIds.has(id)) {
                showToast('已膜拜过啦', '你已经为这位群友点过赞了哦~', 'fa-solid fa-heart');
                return;
            }
            likedPostIds.add(id);

            if (isSeed) {
                const target = starterHighlights.find(item => item.id === id);
                if (target) target.likes += 1;
                renderHighlightsGrid();
                showToast('打Call成功！', '群友收到了你的膝盖 (+1)', 'fa-solid fa-heart');
                return;
            }

            try {
                const { db, appId, doc, updateDoc } = window.fb;
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'rhythm_highlights', id);
                await updateDoc(docRef, {
                    likes: currentLikes + 1
                });
                showToast('打Call成功！', '数据已同步至云端 (+1)', 'fa-solid fa-heart');
            } catch (e) {
                console.error("Like error:", e);
            }
        }

        async function deleteHighlight(id) {
            if (!window.currentUser) return;
            try {
                const { db, appId, doc, deleteDoc } = window.fb;
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'rhythm_highlights', id);
                await deleteDoc(docRef);
                showToast('已删除', '该条动态已从云端移除', 'fa-solid fa-trash-can');
            } catch (e) {
                console.error("Delete error:", e);
            }
        }

        function openPostModal() {
            document.getElementById('postModal').classList.remove('hidden');
        }
        function closePostModal() {
            document.getElementById('postModal').classList.add('hidden');
        }

        function openLightbox(imgSrc, title, desc) {
            document.getElementById('lightbox-img').src = imgSrc;
            document.getElementById('lightbox-title').innerText = title || '鲁东大学音乐游戏群线下日常';
            document.getElementById('lightbox-desc').innerText = desc || '';
            document.getElementById('lightboxModal').classList.remove('hidden');
        }
        function closeLightbox() {
            document.getElementById('lightboxModal').classList.add('hidden');
        }

        function copyGroupCode(code) {
            const temp = document.createElement('textarea');
            temp.value = code;
            temp.style.position = 'fixed';
            document.body.appendChild(temp);
            temp.select();
            try {
                document.execCommand('copy');
                showToast('群号已复制！', `QQ群号 ${code} 已复制，快去添加吧！`, 'fa-solid fa-check');
            } catch (e) {
                showToast('复制提示', `请手动复制群号：${code}`);
            }
            document.body.removeChild(temp);
        }

        allHighlights = [...starterHighlights];
        renderHighlightsGrid();

        const canvas = document.getElementById('rhythmCanvas');
        const ctx = canvas.getContext('2d');
        let cw, ch;
        const notes = [];

        function resizeBg() {
            cw = canvas.width = window.innerWidth;
            ch = canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeBg);
        resizeBg();

        class RhythmNote {
            constructor() {
                this.reset();
            }
            reset() {
                this.x = Math.random() * cw;
                this.y = ch + Math.random() * 200;
                this.width = Math.random() * 28 + 12;
                this.height = 5;
                this.speed = Math.random() * 1.4 + 0.5;
                this.color = Math.random() > 0.5 ? '#05d9e8' : '#ff2a85';
                this.alpha = Math.random() * 0.45 + 0.15;
            }
            update() {
                this.y -= this.speed;
                if (this.y < -20) this.reset();
            }
            draw() {
                ctx.save();
                ctx.globalAlpha = this.alpha;
                ctx.fillStyle = this.color;
                ctx.shadowBlur = 12;
                ctx.shadowColor = this.color;
                ctx.fillRect(this.x, this.y, this.width, this.height);
                ctx.restore();
            }
        }

        for (let i = 0; i < 36; i++) notes.push(new RhythmNote());

        function animateBg() {
            ctx.clearRect(0, 0, cw, ch);
            notes.forEach(n => { n.update(); n.draw(); });
            requestAnimationFrame(animateBg);
        }
        window.onload = function() {
            animateBg();
        };
    </script>
