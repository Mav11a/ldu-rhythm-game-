            <div class="bg-black flex items-center justify-center max-h-[70vh] overflow-hidden">
                <img id="lightbox-img" src="" alt="预览大图" class="w-full h-auto max-h-[70vh] object-contain">
            </div>
            <div class="p-5 sm:p-6 bg-cyber-card">
                <h4 id="lightbox-title" class="text-lg sm:text-xl font-black text-white mb-1">照片标题</h4>
                <p id="lightbox-desc" class="text-xs sm:text-sm text-slate-300">照片描述内容</p>
            </div>
        </div>
    </div>

    <script>
