                imageUrl: 'https://images.unsplash.com/photo-1614680376593-902f749f7ffc?auto=format&fit=crop&w=800&q=80',
                content: '在自习室休息时跟群友连麦打歌，受群友玄学Buff加持，把屏幕擦了三遍重开一把居然当场AP推分成功！',
                likes: 64,
                isSeed: true
            },
            {
                id: 'seed-3',
                author: '中二抬手运动员',
                game: 'Chunithm 中二',
                rating: 'Rating 16.35',
                title: '周末机厅拼机常客',
                category: '出勤日常',
                badge: '线下出勤',
                song: '周末机厅拼机 & 萌新带教',
